# Build context optimization for faster Docker builds
# This file reduces build context size by excluding unnecessary files

# Runtime data (logs, caches, temp files)
backend/data/logs/
backend/data/thumbnails/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Development and testing artifacts
backend/tests/
frontend/src/**/*.test.ts
frontend/src/**/*.test.tsx
frontend/tests/
.coverage
.coverage.*
htmlcov/
coverage/
*.cover
.hypothesis/

# Node.js dependencies and build artifacts
node_modules/
frontend/dist/
frontend/node_modules/
pnpm-lock.yaml
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python virtual environments and build artifacts
.venv/
venv/
ENV/
env/
*.egg-info/
dist/
build/
*.egg
*.pyc
__pycache__/
*.so

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Git and version control
.git/
.gitignore
.gitattributes
.gitea/
.github/

# Environment and sensitive files
.env
.env.*
.secrets.baseline
.gitleaks.toml

# CI/CD and documentation
.circleci/
.gitlab-ci.yml
docs/
# ...except the recorded schema upgrades. The docs/ exclude above is right for the rest of the
# tree, but backend/migrations reads its SQL text from docs/api/migrations at STARTUP, so an image
# without that path cannot boot an existing database -- it would only find out on a box that
# actually owed an upgrade. Re-included because the exclude is a parent-directory match (verified:
# the negation re-includes the directory and its contents, and nothing else under docs/).
!docs/api/migrations/**
CHANGELOG.md
README.md
LICENSE

# Mutation testing and analysis
mutants/

# Custom test artifacts
tests/

# Security scanning
.trivyignore
.bandit.yml
.bandit.baseline
