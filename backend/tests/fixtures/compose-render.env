# Minimal env that renders docker-compose.prod.yml — TEST EVIDENCE ONLY.
#
# The prod compose file interpolates exactly two variables with no fallback
# (`${VAR:?}` hard-required), so these two stubs are all `config --services`
# needs. Everything else in the file carries a `:-` default. This is NOT a
# deployment env: the values are fake, and starting the stack with them would
# produce a box that boots nothing real. It exists so the O1.3 Done-when
# render — a plain `config --services`, no profile flag, lists `ai-vlm` — is
# reproducible from the repository instead of someone's /tmp. See
# backend/tests/unit/core/test_compose_render_lists_ai_vlm.py.
PODMAN_SOCKET=/run/user/1000/podman/podman.sock
POSTGRES_PASSWORD=stub
