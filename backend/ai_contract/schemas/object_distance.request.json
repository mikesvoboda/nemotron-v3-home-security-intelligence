{
  "description": "Request format for object distance estimation endpoint.",
  "properties": {
    "bbox": {
      "description": "Bounding box [x1, y1, x2, y2] of object to measure distance to",
      "items": {
        "type": "number"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Bbox",
      "type": "array"
    },
    "image": {
      "description": "Base64 encoded image",
      "title": "Image",
      "type": "string"
    },
    "method": {
      "default": "center",
      "description": "Depth sampling method: 'center', 'mean', 'median', or 'min'",
      "title": "Method",
      "type": "string"
    }
  },
  "required": ["image", "bbox"],
  "title": "ObjectDistanceRequest",
  "type": "object"
}
