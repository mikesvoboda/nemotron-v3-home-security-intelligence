{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/main.tsx!"],
  "project": [
    "src/**/*.{ts,tsx}!",
    "!src/**/*.test.{ts,tsx}!",
    "!src/**/__tests__/**!",
    "!src/**/__mocks__/**!",
    "!src/mocks/**!",
    "!src/test/**!",
    "!src/test-utils/**!"
  ],
  "ignore": ["src/types/generated/**"],
  "ignoreDependencies": ["openapi-typescript"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "off",
    "unlisted": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "off",
    "duplicates": "off",
    "enumMembers": "off",
    "classMembers": "off",
    "nsExports": "off",
    "nsTypes": "off"
  },
  "stryker": {
    "config": ["stryker.config.mjs"],
    "entry": []
  },
  "playwright": {
    "config": ["playwright.config.ts"],
    "entry": []
  },
  "vitest": {
    "config": ["vite.config.ts", "vite.config.e2e.ts"],
    "entry": []
  }
}
