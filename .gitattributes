# Git Attributes Configuration
# https://git-scm.com/docs/gitattributes
# ============================================================================
# Git LFS - Large File Storage  (REMOVED 2026-09-15)
# LFS filter rules deleted: the only LFS content (571MB of synthetic-media
# pointers) left the repo per owner ruling; free-tier LFS bandwidth/storage
# is not worth the accidental-pointer-commit risk. If binaries must return,
# re-add explicit rules AND keep them out of free-quota surprises.
# ============================================================================
# Merge Drivers
# Beads JSONL files - custom merge driver for issue tracking
.beads/issues.jsonl merge=beads
# Binary Files - Do not diff these files
# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
# Archives
*.zip binary
*.tar binary
*.gz binary
*.7z binary
# Text Files - Ensure consistent line endings
# Force LF line endings for all text files (important for cross-platform dev)
* text=auto eol=lf
# Shell scripts - always LF
*.sh text eol=lf
# Python - always LF
*.py text eol=lf
*.pyi text eol=lf
# JavaScript/TypeScript - always LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
# Configuration files
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
# Documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf
# Docker
Dockerfile text eol=lf
*.dockerfile text eol=lf
# Export Ignore - Files excluded from git archive
# Development files
.github/ export-ignore
.vscode/ export-ignore
.idea/ export-ignore
tests/ export-ignore
backend/tests/ export-ignore
frontend/tests/ export-ignore
# CI/CD
.pre-commit-config.yaml export-ignore
.secrets.baseline export-ignore
# Documentation source (keep compiled docs)
docs/ export-ignore
# Development configs
.editorconfig export-ignore
.gitattributes export-ignore
.gitignore export-ignore
# Linguist - Language statistics customization
# Mark generated files
frontend/src/api/types.ts linguist-generated=true
# Exclude from language statistics
*.lock linguist-generated=true
package-lock.json linguist-generated=true
uv.lock linguist-generated=true
