# Pet Classification - ONNX Runtime on GPU (ResNet-18, NEM-5551)
# Input: preprocessed image (B, 3, 224, 224) FP32
# Output: class logits (2 classes: cat, dog)
# Source: ai/enrichment-light/model.py PetClassifier (AutoImageProcessor -> 224x224)
# NEM-5551: Promoted from CPU to GPU (~2x speedup, ~45MB on GPU)

name: "pet"
backend: "onnxruntime"
max_batch_size: 8

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 3, 224, 224 ]
  }
]

output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [ 2 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
    rate_limiter {
      resources [
        { name: "global" count: 1 }
      ]
      priority: 3
    }
  }
]

dynamic_batching {
  preferred_batch_size: [1, 4, 8]
  max_queue_delay_microseconds: 100000
}

# ResNet-18 cat/dog classifier (GPU-accelerated)
# Preprocessing: AutoImageProcessor (resize 224x224, normalize ImageNet)
