# Pet Classification - ONNX Runtime (ResNet-18)
# Input: preprocessed image (B, 3, 224, 224) FP32
# Output: class logits (2 classes: cat, dog)
# Source: ai/enrichment-light/model.py PetClassifier (AutoImageProcessor -> 224x224)

name: "pet"
platform: "onnxruntime_onnx"
max_batch_size: 8

input [
  {
    name: "pixel_values"
    data_type: TYPE_FP32
    dims: [ 3, 224, 224 ]
  }
]

output [
  {
    name: "logits"
    data_type: TYPE_FP32
    dims: [ 2 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

dynamic_batching {
  preferred_batch_size: [ 1, 4 ]
  max_queue_delay_microseconds: 100
}

# ResNet-18 cat/dog classifier
# Preprocessing: AutoImageProcessor (resize 224x224, normalize ImageNet)
