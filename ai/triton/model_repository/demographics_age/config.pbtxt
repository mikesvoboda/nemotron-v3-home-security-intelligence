# Age Classification - ONNX Runtime (ViT)
# Input: preprocessed face/person crop (B, 3, 224, 224) FP32
# Output: age class logits (6 age ranges)
# Source: ai/enrichment/models/demographics.py (ViT, AutoImageProcessor -> 224x224)
#
# Age ranges: 0-10, 11-20, 21-35, 36-50, 51-65, 65+

name: "demographics_age"
platform: "onnxruntime_onnx"
max_batch_size: 8

input [
  {
    name: "pixel_values"
    data_type: TYPE_FP32
    dims: [ 3, 224, 224 ]
  }
]

output [
  {
    name: "logits"
    data_type: TYPE_FP32
    dims: [ 6 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

dynamic_batching {
  preferred_batch_size: [ 1, 4 ]
  max_queue_delay_microseconds: 100
}

# nateraw/vit-age-classifier or similar ViT-based age classification model
# Preprocessing handled by AutoImageProcessor (standard ViT 224x224)
