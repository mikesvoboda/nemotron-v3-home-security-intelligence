# YOLO26m Object Detection - ONNX Runtime
# Input: image tensor [1, 3, 640, 640] FP32 (static batch=1 from Ultralytics export)
# Output: post-NMS detections [1, 300, 6] FP32 (300 max detections, 6 = x1,y1,x2,y2,score,class)
# Source: ai/yolo26/model.py (imgsz=640, 80 COCO classes)
#
# ONNX Runtime with CUDA EP is used instead of TensorRT because the
# RTX A400 (4 GB) does not have enough workspace memory for TensorRT
# engine building.  ONNX Runtime provides near-TensorRT performance.
#
# The gateway adapter (ai/gateway/adapters/yolo26.py) handles letterbox
# preprocessing and coordinate rescaling on the post-NMS output.

name: "yolo26"
backend: "onnxruntime"
max_batch_size: 0

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [ 1, 3, 640, 640 ]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [ 1, 300, 6 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

rate_limiter {
  resources [
    { name: "GPU_MEMORY" count: 1 }
  ]
  priority: 1
}

# YOLO26m ONNX model exported via Ultralytics .export(format='onnx')
# Static batch=1: max_batch_size=0, full shape including batch dim in dims
# 80 COCO detection classes, post-NMS output with up to 300 detections
