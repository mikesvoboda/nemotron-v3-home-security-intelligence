# YOLO26m Object Detection - ONNX Runtime
# Input: image tensor [1, 3, 640, 640] FP32 (static batch=1 from Ultralytics export)
# Output: raw YOLO tensor [1, 84, 8400] FP32 (84 = 4 box + 80 COCO class scores)
# Source: ai/yolo26/model.py (imgsz=640, 80 COCO classes)
#
# The gateway adapter (ai/gateway/adapters/yolo26.py) handles letterbox
# preprocessing, NMS, and coordinate rescaling on the raw output.

name: "yolo26"
backend: "onnxruntime"
max_batch_size: 0

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [ 1, 3, 640, 640 ]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [ 1, 84, 8400 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

# YOLO26m ONNX model exported via Ultralytics .export(format='onnx')
# Static batch=1: max_batch_size=0, full shape including batch dim in dims
# 80 COCO detection classes, 8400 prediction anchors at 640x640 input
