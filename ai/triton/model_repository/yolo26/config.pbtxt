# YOLO26m Object Detection - ONNX Runtime (INT8 quantized, NEM-5547)
# Input: image tensor [1, 3, 640, 640] FP32 (static batch=1 from Ultralytics export)
# Output: post-NMS detections [1, 300, 6] FP32 (300 max detections, 6 = x1,y1,x2,y2,score,class)
# Source: ai/yolo26/model.py (imgsz=640, 80 COCO classes)
#
# INT8 quantization via onnxruntime.quantization provides ~20-40% latency
# reduction and ~50% model size reduction with minimal accuracy loss (<1% mAP).
# The model is served via ONNX Runtime with CUDA EP (same backend, smaller model).
#
# Export: ai/gateway/export/export_yolo26.py --int8
# Calibration: pass --calibration-data /export/foscam/ for static quantization
#
# The gateway adapter (ai/gateway/adapters/yolo26.py) handles letterbox
# preprocessing and coordinate rescaling on the post-NMS output.

name: "yolo26"
backend: "onnxruntime"
max_batch_size: 0

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [ 1, 3, 640, 640 ]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [ 1, 300, 6 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

# YOLO26m ONNX INT8 model: Ultralytics .export(format='onnx') + onnxruntime.quantization
# Static batch=1: max_batch_size=0, full shape including batch dim in dims
# 80 COCO detection classes, post-NMS output with up to 300 detections
