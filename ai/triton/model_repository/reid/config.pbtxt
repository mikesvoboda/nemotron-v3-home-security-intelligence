# Person Re-Identification - TensorRT on GPU (OSNet-AIN x1.0)
# O2.4 (owner ruling 107): served through TensorRT, "a plan built for the serving
#   GPU as yolo26's is" — the ONNX Runtime CUDA execution provider fails on the
#   GB300 (ruling 106: cudaErrorSymbolNotFound on Blackwell/aarch64, 26.01-py3).
#   1/model.plan is compiled on the serving host by
#   ai/gateway/export/export_reid.py --output-path .../model.plan (trtexec), and
#   entrypoint.sh §0c links it in from /models/cache like every exported model.
# Upgraded from OSNet-x0.25 to OSNet-AIN x1.0 for 4x better accuracy (NEM-5562)
# NEM-5551: Promoted from CPU to GPU (~2x speedup, ~9MB on GPU)
# Input: preprocessed person crop (B, 3, 256, 128) FP32
# Output: L2-normalized embedding (B, 512) FP32
# Source: ai/enrichment-light/models/person_reid.py
#   OSNET_INPUT_HEIGHT=256, OSNET_INPUT_WIDTH=128, EMBEDDING_DIMENSION=512
# Weights: MSMT17 domain-generalization trained (Rank-1: 73.3%)
# Provenance (B2.2): 1/provenance.json is written beside the ONNX the plan is
#   compiled from and travels with the version dir; the plan never rewrites it.

name: "reid"
backend: "tensorrt"
max_batch_size: 16

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 3, 256, 128 ]
  }
]

output [
  {
    name: "embedding"
    data_type: TYPE_FP32
    dims: [ 512 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
    rate_limiter {
      resources [
        { name: "global" count: 1 }
      ]
      priority: 2
    }
  }
]

dynamic_batching {
  preferred_batch_size: [1, 4, 8]
  max_queue_delay_microseconds: 100000
}

# OSNet-AIN x1.0 person re-identification model (~9MB ONNX -> FP16 plan, GPU)
# AIN = Attention-based Instance Normalization for better cross-domain generalization
# Same input/output dims as OSNet-x0.25: drop-in replacement
# Preprocessing: Resize(256,128), ToTensor, Normalize(ImageNet)
# The plan carries batch profiles 1/8/16 (the builder's --min/opt/maxShapes), so
# the dynamic_batching preferred sizes above are satisfiable inside the engine.
