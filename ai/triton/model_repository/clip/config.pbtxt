# CLIP ViT-L/14 Image Embedding - TensorRT FP16
# Input: preprocessed image (B, 3, 224, 224) FP16
# Output: L2-normalized embedding (B, 768) FP32
# Source: ai/clip/model.py (CLIPProcessor resizes to 224x224, embedding dim 768)

name: "clip"
platform: "tensorrt_plan"
max_batch_size: 8

input [
  {
    name: "pixel_values"
    data_type: TYPE_FP16
    dims: [ 3, 224, 224 ]
  }
]

output [
  {
    name: "embedding"
    data_type: TYPE_FP32
    dims: [ 768 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

dynamic_batching {
  preferred_batch_size: [ 1, 4, 8 ]
  max_queue_delay_microseconds: 100
}

# Vision encoder only (text encoder runs in gateway for classify/similarity)
# Engine file (model.plan) generated by export_clip.py at deploy time
