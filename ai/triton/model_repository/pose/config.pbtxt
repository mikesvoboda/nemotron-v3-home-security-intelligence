# YOLOv8n-pose Pose Estimation - ONNX Runtime
# Input: image tensor (B, 3, 640, 640) FP32
# Output: keypoints (17 COCO keypoints x,y,conf) + detection boxes
# Source: ai/enrichment-light/models/pose_estimator.py (640x640 input)

name: "pose"
backend: "onnxruntime"
max_batch_size: 8

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [ 3, 640, 640 ]
  }
]

output [
  {
    name: "boxes"
    data_type: TYPE_FP32
    dims: [ -1, 4 ]
  },
  {
    name: "scores"
    data_type: TYPE_FP32
    dims: [ -1 ]
  },
  {
    name: "keypoints"
    data_type: TYPE_FP32
    dims: [ -1, 17, 3 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

dynamic_batching {
  preferred_batch_size: [ 1, 4 ]
  max_queue_delay_microseconds: 100
}

# YOLOv8n-pose ONNX model exported via Ultralytics .export(format='onnx')
# 17 COCO keypoints: nose, eyes, ears, shoulders, elbows, wrists, hips, knees, ankles
