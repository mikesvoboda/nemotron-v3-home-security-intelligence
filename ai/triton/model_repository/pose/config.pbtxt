# YOLOv8n-pose Pose Estimation - ONNX Runtime on GPU (NEM-5551)
# Input: image tensor [1, 3, 640, 640] FP32 (static batch=1 from Ultralytics export)
# Output: raw YOLO tensor [1, 56, 8400] FP32 (56 = 4 box + 1 conf + 17*3 keypoints)
# Source: ai/enrichment-light/models/pose_estimator.py (640x640 input)
#
# NEM-5551: Promoted from CPU to GPU after Category 3 model swaps freed 85% of A400 VRAM.
# ONNX Runtime with CUDAExecutionProvider gives ~2x speedup over CPU execution.
# Model size: ~14MB ONNX (~14MB on GPU)

name: "pose"
backend: "onnxruntime"
max_batch_size: 0

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [ 1, 3, 640, 640 ]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [ 1, 56, 8400 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

# YOLOv8n-pose ONNX model exported via Ultralytics .export(format='onnx')
# Static batch=1: max_batch_size=0, full shape including batch dim in dims
# 17 COCO keypoints: nose, eyes, ears, shoulders, elbows, wrists, hips, knees, ankles
