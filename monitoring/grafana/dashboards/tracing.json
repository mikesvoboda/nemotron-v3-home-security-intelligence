      },
      "pluginVersion": "10.2.3",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (service) (rate(http_request_duration_seconds_count[5m]) * 60)",
          "legendFormat": "{{service}}",
          "range": true,
          "refId": "backend"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(yolo26_inference_requests_total[5m]) * 60)",
          "legendFormat": "yolo26",
          "range": true,
          "refId": "yolo26"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(florence_inference_requests_total[5m]) * 60)",
          "legendFormat": "florence",
          "range": true,
          "refId": "florence"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(clip_inference_requests_total[5m]) * 60)",
          "legendFormat": "clip",
          "range": true,
          "refId": "clip"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(enrichment_inference_requests_total[5m]) * 60)",
          "legendFormat": "enrichment",
          "range": true,
          "refId": "enrichment"
