# env-templates/gb300.env.template — host deltas applied after setup.py generation.
# Lines are KEY=VALUE, applied verbatim, last-wins. Rationale beside each.
GPU_AI_SERVICES=0        # single GB300 (sm_103, 256GB): there is no GPU 1 (host probe 2026-09-12)
GPU_LLM=0                # same reason; M2 relevance only
PODMAN_SOCKET=/run/user/UID_PLACEHOLDER/podman/podman.sock  # backend orchestrator mount
TMPDIR=/home/UID_NAME_PLACEHOLDER/.cache/nemotron-tmp  # .env.example ships /ephemeral/podman-tmp which does not exist here (blocker-audit, verified)
CUDA_ARCHITECTURES=103   # M2 seed: host cc 10.3 detected; consumed only when ai-llm builds. Re-verify at M2 (sm_103 vs 103a family target, llama.cpp commit bump). Never 89 (the .env.example value).
FOSCAM_BASE_PATH=/home/msvoboda/.local/share/nemotron/foscam  # generation default /export/foscam belongs to a co-resident product (uid 1001, 26GB live camera data); foscam-init chowns -R whatever this points at, so the default is prohibited here
AI_MODELS_PATH=/home/msvoboda/.local/share/nemotron/ai_models  # generation default /export/ai_models is the other install's namespace; do not create or touch it on this host
# API_PORT intentionally NOT pinned here: setup.py run_defaults_mode() resolves :8000
# (held by co-resident dgx-inference-vllm) via find_available_port at generation time.
