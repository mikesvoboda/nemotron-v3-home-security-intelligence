# env-templates/a5500.env.template — host deltas for the RTX A5500 bring-up box (plan 1.7).
#
# THIS IS NOT A SUBSTITUTE FOR GENERATION. Apply it AFTER setup.py generates .env, exactly
# like gb300.env.template. Lines are KEY=VALUE, applied verbatim, last-wins. Do NOT
# `cp .env.example .env` and edit: docs/getting-started/installation.md:60 forbids it
# because .env.example ships placeholder credentials and setup.py is what generates real
# ones (docs/developer/local-setup.md:179 says the opposite — that contradiction is
# recorded in the A5500 handout and in the ledger; generation is the supported path).
#
# Why a separate template exists: `docker compose --env-file .env.example config` ABORTS
# on this repo — PODMAN_SOCKET (docker-compose.prod.yml:1513) and POSTGRES_PASSWORD (:69,
# a hard `:?` with no default) are interpolated with no fallback. So the shipped example
# is not a starting point for a cold box, and gb300.env.template is the wrong one (it pins
# CUDA_ARCHITECTURES=103 and GB300 host paths that do not exist here).
#
# Replace the three PLACEHOLDER values before use. Nothing here is a secret; secrets come
# from setup.py generation.

# ── GPU: one A5500, nothing else ─────────────────────────────────────────────
# The shipped .env.example is dual-GPU (GPU_YOLO26/CLIP/ENRICHMENT/ENRICHMENT_LIGHT=1,
# GPU_AI_SERVICES=1). Single-GPU means ALL of them zero — this is the precheck's
# `gpu_assignment` FAIL until it is done.
GPU_AI_SERVICES=0
GPU_YOLO26=0
GPU_CLIP=0
GPU_ENRICHMENT=0
GPU_ENRICHMENT_LIGHT=0
GPU_LLM=0                # retired serving path; 0 is also its shipped value
GPU_FLORENCE=0           # retired enrichment; not deployed (spec rev 5 / F10)

# ── CUDA arch: 86, and it must be right BEFORE the build ─────────────────────
# .env.example ships 89 (Ada). 89 is NOT a superset of 86 (Ampere) and there is no `+PTX`
# anywhere in ai/, so a wrong-arch binary has no JIT fallback: it builds, it starts, it
# dies on the first CUDA kernel. A5500 = sm_86.
CUDA_ARCHITECTURES=86

# ── Paths that this host owns ────────────────────────────────────────────────
# AI_MODELS_PATH is never ASSIGNED in .env.example (setup.py writes it), and the ai-vlm
# mount is ${AI_MODELS_PATH:-/export/ai_models}/vlm:/models:ro — unset, it silently
# targets /export/ai_models and the serve fails on a missing file. Set it, create
# <it>/vlm/, drop BOTH GGUF pairs there, then `chmod 644` them: bake-off finding F is
# that fetched weights arrive mode 640 and ai/vlm runs as uid 1000.
AI_MODELS_PATH=/home/UID_NAME_PLACEHOLDER/.local/share/nemotron/ai_models

PODMAN_SOCKET=/run/user/UID_PLACEHOLDER/podman/podman.sock   # required; no compose default

# TMPDIR must be a directory that exists. .env.example ships /ephemeral/podman-tmp, which
# does not exist on a fresh box. backend/api/routes/system.py's _runtime_env_path() allows
# only ./data, /data, the temp dir and cwd — an unmatched path LOGS and silently falls
# back to ./data/runtime.env rather than failing, so a wrong value here is invisible.
TMPDIR=/home/UID_NAME_PLACEHOLDER/.cache/nemotron-tmp

# ── Serving VLM: the rev 7 shipped identity, restated so the box is explicit ──
# These are already the .env.example defaults as of the M2 flip (ledger item 35); they are
# written here so an A5500 reader sees what the box is meant to serve without reading the
# spec. The 4B pair is the named FALLBACK row — swap only these two paths for its reading.
VLM_MODEL_PATH=/models/Qwen3VL-8B-Instruct-Q4_K_M.gguf
VLM_MMPROJ_PATH=/models/mmproj-Qwen3VL-8B-Instruct-Q8_0.gguf
VLM_MODEL_ID=Qwen3VL-8B-Instruct-Q4_K_M

# ── Intentionally NOT pinned ─────────────────────────────────────────────────
# VLM_CTX_SIZE / VLM_PARALLEL: keep the shipped 32768 / 2 (16384 per slot covers the
#   ~12.2K-token worst case). S1's number is meaningless without them, so record them.
# VLM_GPU_LAYERS: leave `auto` and use NO --n-gpu-layers reduction. S1 forbids CPU offload
#   of the VLM, so a reduced serve is not a passing serve — record whether offload happened.
# VLM_REQUIRED_BUILD: stays b7972 and must move only WITH ai/vlm/Dockerfile's LLAMA_CPP_REF.
#   The client's check (backend/services/vlm_client.py:268) is a substring test and fails
#   closed; it is also arch-blind, so record compute_cap beside /props build_info.
# API_PORT / POSTGRES_* / secrets: setup.py's job, not this file's.
