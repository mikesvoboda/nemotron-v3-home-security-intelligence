diff --git a/.github/workflows/nightly-full-gate-schedule-only.yml b/.github/workflows/nightly-full-gate-schedule-only.yml
new file mode 100644
--- /dev/null
+++ b/.github/workflows/nightly-full-gate-schedule-only.yml
@@ -0,0 +1,175 @@
+# Nightly honest full gate — SCHEDULE-ONLY VARIANT (draft B).
+#
+# Identical jobs to nightly-full-gate.yml (draft A) minus workflow_dispatch.
+# Rationale for shipping this variant if the nightly is landed BEFORE T13:
+#   - A scheduled nightly is the honest artifact spec §5.4 requires
+#     ("the full suite ran somewhere trustworthy yesterday") and it has ZERO
+#     code dependency on validate.sh --fast or the fast-tier runners — the
+#     full gate is --fast-free by construction (spec §4.2).
+#   - workflow_dispatch is what makes the nightly a developer-facing
+#     "full gate on demand" button, i.e. the thing that REPLACES local
+#     validate.sh runs on the critical path. That positioning only makes
+#     sense once --fast exists locally (T13, itself gated on the M1 §6
+#     record + Tasks 10-12). Landing A early hands out a full-gate button
+#     while the fast alternative is still frozen.
+# Apply-gate difference vs A: B needs only the M1 §6 record (the nightly
+# runs governed files, never edits them); A additionally wants T13 applied
+# so the dispatch button has a local counterpart.
+name: Nightly Full Gate
+on:
+  schedule:
+    - cron: '17 4 * * *' # UTC 04:17 — off the :00 herd (plan Task 14 convention)
+
+permissions:
+  contents: read
+
+concurrency:
+  group: nightly-full-gate-${{ github.ref }}
+  cancel-in-progress: false
+
+jobs:
+  backend-full:
+    name: Backend full gate (validate.sh semantics)
+    runs-on: ubuntu-latest
+    timeout-minutes: 240
+    services:
+      postgres:
+        image: postgres:16-alpine
+        env:
+          POSTGRES_USER: postgres
+          POSTGRES_PASSWORD: postgres # pragma: allowlist secret
+          POSTGRES_DB: security_test
+        ports:
+          - 5432:5432
+        options: >-
+          --health-cmd "pg_isready -U postgres"
+          --health-interval 10s
+          --health-timeout 5s
+          --health-retries 5
+      redis:
+        image: redis:7-alpine
+        ports:
+          - 6379:6379
+        options: >-
+          --health-cmd "redis-cli ping"
+          --health-interval 10s
+          --health-timeout 5s
+          --health-retries 5
+    env:
+      DATABASE_URL: postgresql+asyncpg://postgres:postgres@localhost:5432/security_test # pragma: allowlist secret
+      TEST_DATABASE_URL: postgresql+asyncpg://postgres:postgres@localhost:5432/security_test # pragma: allowlist secret
+      REDIS_URL: redis://localhost:6379
+      REDIS_HOST: localhost
+      REDIS_PORT: '6379'
+      LOG_DB_ENABLED: 'false'
+      ENVIRONMENT: development
+      CI: 'true'
+    steps:
+      - name: Checkout
+        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4
+      - name: Set up uv
+        uses: astral-sh/setup-uv@e4db8464a088ece1b920f60402e813ea4de65b8f # v4
+        with:
+          enable-cache: true
+      - name: Install dependencies
+        run: uv sync --extra dev --frozen
+      - name: Backend unit+contracts+security tier (validate.sh semantics)
+        run: |
+          set -eu
+          mkdir -p /tmp/fcl-cov
+          if ! COVERAGE_FILE=/tmp/fcl-cov/.coverage.unit \
+            uv run pytest backend/tests/unit backend/tests/contracts backend/tests/security \
+            --cov=backend --cov-report= --cov-fail-under=0 \
+            --ignore=backend/tests/load --ignore=backend/tests/benchmarks \
+            --ignore=backend/tests/e2e --ignore=backend/tests/chaos \
+            > /tmp/nightly-backend-unit.log 2>&1; then
+            echo "[ERROR] unit tier failed — log tail:" >&2
+            tail -80 /tmp/nightly-backend-unit.log >&2 || true
+            exit 1
+          fi
+          tail -5 /tmp/nightly-backend-unit.log
+      - name: Backend integration tier (validate.sh semantics)
+        run: |
+          set -eu
+          if ! COVERAGE_FILE=/tmp/fcl-cov/.coverage.integration \
+            uv run pytest backend/tests/integration \
+            --cov=backend --cov-report= --cov-fail-under=0 \
+            --ignore=backend/tests/load --ignore=backend/tests/benchmarks \
+            --ignore=backend/tests/e2e --ignore=backend/tests/chaos \
+            --timeout=30 > /tmp/nightly-backend-integration.log 2>&1; then
+            echo "[ERROR] integration tier failed — log tail:" >&2
+            tail -80 /tmp/nightly-backend-integration.log >&2 || true
+            exit 1
+          fi
+          tail -5 /tmp/nightly-backend-integration.log
+      - name: Combined coverage gate (80%, validate.sh semantics)
+        if: always()
+        run: |
+          set -eu
+          uv run python -m coverage combine --data-file=/tmp/fcl-cov/.coverage \
+            /tmp/fcl-cov/.coverage.unit /tmp/fcl-cov/.coverage.integration
+          uv run python -m coverage report --data-file=/tmp/fcl-cov/.coverage \
+            --fail-under=80 --show-missing > /tmp/nightly-coverage-report.log
+          tail -1 /tmp/nightly-coverage-report.log > /tmp/fcl-cov/summary-cov.txt
+      - name: Honesty summary (artifact-derived; feeds spec 6.1 trend)
+        if: always()
+        run: |
+          {
+            echo "## Nightly full gate — backend"
+            echo "- combined coverage: $(cat /tmp/fcl-cov/summary-cov.txt 2>/dev/null || echo 'not produced (a tier failed — see the red step, not this line)')"
+            echo '- tier close lines (verbatim from the logs):'
+            echo '```'
+            grep -hE '=====.*(passed|failed|error).*=====' /tmp/nightly-backend-*.log 2>/dev/null | tail -4 || echo 'no summary lines produced'
+            echo '```'
+          } >> "$GITHUB_STEP_SUMMARY"
+  frontend-full:
+    name: Frontend full gate (honest exit code)
+    runs-on: ubuntu-latest
+    timeout-minutes: 240
+    env:
+      NODE_OPTIONS: '--max-old-space-size=8192 --expose-gc'
+    steps:
+      - name: Checkout
+        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4
+      - name: Set up Node.js
+        uses: actions/setup-node@6044e13b5dc448c55e2357c09f80417699197238 # v6
+        with:
+          node-version: '20'
+          cache: 'npm'
+          cache-dependency-path: frontend/package-lock.json
+      - name: Install dependencies
+        run: cd frontend && npm ci
+      - name: Run full vitest suite (real exit code)
+        run: |
+          set -eu
+          cd frontend
+          set +e
+          npx vitest run --reporter=default --teardownTimeout=1000 \
+            > /tmp/nightly-vitest.log 2>&1
+          RC=$?
+          set -e
+          echo "vitest exit=$RC"
+          tail -12 /tmp/nightly-vitest.log || true
+          exit $RC
+      - name: Honesty summary (log-file derived)
+        if: always()
+        run: |
+          {
+            echo "## Nightly full gate — frontend"
+            echo '```'
+            grep -E 'Test Files |Tests |Duration ' /tmp/nightly-vitest.log 2>/dev/null | tail -6 || echo 'no summary line produced (process died before reporting — that is still RED; the step exit says so)'
+            echo '```'
+          } >> "$GITHUB_STEP_SUMMARY"
+  status:
+    name: Nightly status
+    needs: [backend-full, frontend-full]
+    if: always()
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - name: Aggregate (anything but two successes is red — no silent skips)
+        run: |
+          echo "nightly full gate: backend=${{ needs.backend-full.result }} frontend=${{ needs.frontend-full.result }}" \
+            >> "$GITHUB_STEP_SUMMARY"
+          [ "${{ needs.backend-full.result }}" = "success" ] && \
+          [ "${{ needs.frontend-full.result }}" = "success" ]
