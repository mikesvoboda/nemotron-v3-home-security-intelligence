# Depth Estimation - ONNX Runtime on GPU (Depth Anything V2 Tiny / DPT-Tiny, NEM-5551)
# Input: preprocessed image (B, 3, 518, 518) FP32
# Output: depth map (B, 1, 518, 518) FP32
# Source: ai/enrichment-light/model.py DepthEstimator (AutoImageProcessor -> 518x518)
#
# Depth Anything V2 Tiny uses DPT architecture with 518x518 input resolution.
# 3x faster inference than Small variant (5.8M vs 24.8M parameters).
# Output depth map is relative (not metric) and needs min-max normalization.
# NEM-5551: Promoted from CPU to GPU (~2x speedup, ~101MB on GPU)
# NOTE: ONNX model needs re-export from Tiny weights when model is downloaded.

name: "depth"
backend: "onnxruntime"
max_batch_size: 0

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 1, 3, 518, 518 ]
  }
]

output [
  {
    name: "depth_map"
    data_type: TYPE_FP32
    dims: [ 1, 518, 518 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
    rate_limiter {
      resources [
        { name: "global" count: 1 }
      ]
      priority: 3
    }
  }
]

# Static batch=1: DPT head has hardcoded Reshape that breaks dynamic batching
