# SigLIP 2 Base (patch16-224) Vision Encoder - ONNX Runtime
# Replaces CLIP ViT-L/14 (1.2GB -> 178MB FP16, saves 1,035MB VRAM)
# Input: preprocessed image (B, 3, 224, 224) FP32
# Output: embedding (B, 768) FP32
# Normalization: mean=[0.5, 0.5, 0.5], std=[0.5, 0.5, 0.5]
# Source: onnx-community/siglip2-base-patch16-224-ONNX (vision_model_fp16.onnx)

name: "clip"
backend: "onnxruntime"
max_batch_size: 8

input [
  {
    name: "pixel_values"
    data_type: TYPE_FP32
    dims: [ 3, 224, 224 ]
  }
]

output [
  {
    name: "pooler_output"
    data_type: TYPE_FP32
    dims: [ 768 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
    rate_limiter {
      resources [
        { name: "global" count: 1 }
      ]
      priority: 2
    }
  }
]

dynamic_batching {
  preferred_batch_size: [1, 2, 4]
  max_queue_delay_microseconds: 50000
}
